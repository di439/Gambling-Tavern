[sub_resource type="GDScript" id="GDScript_qi2q2"]
resource_name = "检测面板数据"
script/source = "extends Panel

@export var target: Node              # 要监视的玩家
@onready var data_label: Label = $data
@onready var time_label: Label = $test_time
@onready var timer: Timer = $data_updating

var elapsed := 0.0

func _ready() -> void:
	timer.timeout.connect(_update)
	timer.start()
	
	Log.message_added.connect(_on_log)
	$LogLabel.clear()

func _update() -> void:
	# 时间
	elapsed += timer.wait_time
	time_label.text = \"时间：%.1f 秒\" % elapsed
	
	# 状态
	if target and target.state_machine:
		var state_name = target.state_machine.get_state_name()
		data_label.text = \"状态：%s\" % state_name
	else:
		data_label.text = \"状态：未知\"

func _on_log(text: String) -> void:
	$LogLabel.append_text(text + \"\\n\")
"

